# Postgres connection string. Any managed Postgres works (Supabase, Neon,
# Vercel Postgres, Prisma Postgres, RDS, etc.) — see README "Database".
DATABASE_URL="postgresql://user:password@host:5432/dbname"

# Optional: override the seeded admin account (see prisma/seed.ts).
# ADMIN_SEED_EMAIL="owner@example.com"
# ADMIN_SEED_PASSWORD="change-me"

# Optional: real transactional email via Resend (https://resend.com).
# Without this set, emails are only logged to the EmailLog table (visible
# nowhere in the UI yet, but inspectable via the database) — nothing is
# actually sent.
# RESEND_API_KEY="re_xxx"
# EMAIL_FROM="Nailed It Jess <bookings@yourdomain.com>"

# Used to build absolute links in emails (manage-booking links, dashboard
# links). Set this to your deployed URL in production.
# NEXT_PUBLIC_SITE_URL="https://naileditbyjess.example"

# Shared secret the reminder cron endpoint checks for
# (Authorization: Bearer <value>) — see README "Appointment Reminders".
# CRON_SECRET="change-me"
